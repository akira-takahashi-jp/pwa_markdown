{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "pages",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "BASE_PATH=/pwa_markdown/ npx vite preview --port 4174 --strictPort"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    }
  ]
}